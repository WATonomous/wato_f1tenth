    "Indicator!state": {
      "path": "/control/status.state",
      "style": "background",
      "fallbackColor": "#d62828",
      "fallbackLabel": "OFFLINE",
      "rules": [
        {
          "operator": "=",
          "rawValue": "AUTONOMY",
          "color": "#2e9d47",
          "label": "AUTONOMY"
        },
        {
          "operator": "=",
          "rawValue": "STOPPED",
          "color": "#e07a00",
          "label": "STOPPED"
        },
        {
          "operator": "=",
          "rawValue": "MANUAL",
          "color": "#1f6feb",
          "label": "MANUAL"
        },
        {
          "operator": "=",
          "rawValue": "KEYBOARD",
          "color": "#1f6feb",
          "label": "KEYBOARD"
        },
        {
          "operator": "=",
          "rawValue": "EBRAKE",
          "color": "#d62828",
          "label": "EBRAKE"
        },
        {
          "operator": "=",
          "rawValue": "NO_COMMAND",
          "color": "#6e7681",
          "label": "NOBODY"
        }
      ],
      "foxglovePanelTitle": "Who has control (OFFLINE = drive_status not running, STOPPED = dead man off, NOBODY = nothing reaches the motor)"
    },
