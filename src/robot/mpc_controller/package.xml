<?xml version="1.0"?>
<package format="3">
  <name>mpc_controller</name>
  <version>0.1.0</version>
  <description>CPU kinematic MPC prototype with static costmap corridors.</description>
  <maintainer email="dev@watonomous.ca">WATonomous</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>local_planning</depend>
  <depend>global_planner</depend>
  <depend>rclcpp</depend>
  <depend>ackermann_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>ackermann_mux</exec_depend>
  <exec_depend>sim_util</exec_depend>
  <exec_depend>costmap</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
