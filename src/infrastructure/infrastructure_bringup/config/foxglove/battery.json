{
  "configById": {
    "Gauge!battery_pct": {
      "path": "/hal/battery.percentage",
      "minValue": 0,
      "maxValue": 1,
      "colorMode": "colormap",
      "colorMap": "red-yellow-green",
      "gradient": [
        "#0000ff",
        "#ff00ff"
      ],
      "reverse": false,
      "foxglovePanelTitle": "Drive 3S charge (0-1)"
    },
    "Indicator!battery_health": {
      "path": "/hal/battery.power_supply_health",
      "style": "background",
      "fallbackColor": "#808080",
      "fallbackLabel": "NO DATA (VESC off or unpowered)",
      "rules": [
        {
          "operator": "=",
          "rawValue": "1",
          "color": "#2e9d47",
          "label": "OK"
        },
        {
          "operator": "=",
          "rawValue": "3",
          "color": "#d62828",
          "label": "CRITICAL: stop and charge"
        },
        {
          "operator": "=",
          "rawValue": "4",
          "color": "#e07a00",
          "label": "OVERVOLTAGE: check cell count"
        }
      ],
      "foxglovePanelTitle": "Drive 3S health"
    },
    "Gauge!jetson_battery_pct": {
      "path": "/hal/jetson_battery.percentage",
      "minValue": 0,
      "maxValue": 1,
      "colorMode": "colormap",
      "colorMap": "red-yellow-green",
      "gradient": [
        "#0000ff",
        "#ff00ff"
      ],
      "reverse": false,
      "foxglovePanelTitle": "Jetson 4S charge (0-1)"
    },
    "Indicator!jetson_battery_health": {
      "path": "/hal/jetson_battery.power_supply_health",
      "style": "background",
      "fallbackColor": "#808080",
      "fallbackLabel": "OFF / UNPLUGGED",
      "rules": [
        {
          "operator": "=",
          "rawValue": "1",
          "color": "#2e9d47",
          "label": "OK"
        },
        {
          "operator": "=",
          "rawValue": "3",
          "color": "#d62828",
          "label": "CRITICAL: swap 4S pack"
        },
        {
          "operator": "=",
          "rawValue": "4",
          "color": "#e07a00",
          "label": "OVERVOLTAGE: check scale"
        }
      ],
      "foxglovePanelTitle": "Jetson 4S health"
    },
    "Plot!battery_voltage": {
      "paths": [
        {
          "value": "/hal/battery.voltage",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "drive 3S V"
        },
        {
          "value": "/hal/battery.cell_voltage[0]",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "drive cell V"
        },
        {
          "value": "/hal/jetson_battery.voltage",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "jetson 4S V"
        },
        {
          "value": "/hal/jetson_battery.cell_voltage[0]",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "jetson cell V"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 300,
      "foxglovePanelTitle": "Battery voltages (drive 3S & Jetson 4S)"
    },
    "Plot!battery_current": {
      "paths": [
        {
          "value": "/hal/battery.current",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "A (negative = discharging, VESC only)"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 300,
      "foxglovePanelTitle": "Motor current"
    },
    "RawMessages!battery_raw": {
      "topicPath": "/hal/battery",
      "diffEnabled": false,
      "expansion": "all",
      "foxglovePanelTitle": "/hal/battery"
    },
    "RawMessages!jetson_battery_raw": {
      "topicPath": "/hal/jetson_battery",
      "diffEnabled": false,
      "expansion": "all",
      "foxglovePanelTitle": "/hal/jetson_battery"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "first": {
      "first": {
        "first": "Gauge!battery_pct",
        "second": "Indicator!battery_health",
        "direction": "column",
        "splitPercentage": 65
      },
      "second": {
        "first": "Gauge!jetson_battery_pct",
        "second": "Indicator!jetson_battery_health",
        "direction": "column",
        "splitPercentage": 65
      },
      "direction": "column",
      "splitPercentage": 50
    },
    "second": {
      "first": {
        "first": "Plot!battery_voltage",
        "second": "Plot!battery_current",
        "direction": "column"
      },
      "second": {
        "first": "RawMessages!battery_raw",
        "second": "RawMessages!jetson_battery_raw",
        "direction": "column",
        "splitPercentage": 50
      },
      "direction": "row",
      "splitPercentage": 65
    },
    "direction": "row",
    "splitPercentage": 30
  }
}
