<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>teleop_utils</name>
  <version>0.0.0</version>
  <description>a simple package for converting gamepad input into car outputs</description>
  <maintainer email="muhtasim.business@gmail.com">bolty</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>


  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>joy</depend>
  <depend>ackermann_msgs</depend>

  <test_depend>wato_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
