<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>world_modeling_bringup</name>
  <version>0.0.0</version>
  <description>Launch and configuration for the world_modeling module</description>
  <maintainer email="hello@watonomous.ca">WATonomous</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- To enable Shared Memory IPC -->
  <depend>rmw_zenoh_cpp</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>wato_lifecycle_manager</exec_depend>
  <exec_depend>world_modeling_example</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
